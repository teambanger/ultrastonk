{
  "uid": "ultrastonk",
  "title": "Ultrastonk Kafka / Flink",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "ultrastonk"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Input and accepted events / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_pipeline_receivedEvents[1m]))",
          "refId": "A",
          "legendFormat": "input"
        },
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_pipeline_acceptedEvents[1m]))",
          "refId": "B",
          "legendFormat": "accepted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Committed consumer lag by topic",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (topic) (kafka_consumergroup_lag)",
          "refId": "A",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Price latency: validation to pre-serialization",
      "description": "Clock starts after successful JSON validation and stops before output serialization. Excludes producer and Kafka acknowledgement time.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flink_taskmanager_job_task_operator_user_pipeline_ingressToSinkMs{quantile=~\"0.5|0.95|0.99\"}",
          "refId": "A",
          "legendFormat": "validation to pre-serialization q={{quantile}} task={{subtask_index}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Price event age at pre-serialization",
      "description": "Wall-clock time minus payload event time. Includes replay age and injected lateness; future event timestamps are omitted. Not delivery latency.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flink_taskmanager_job_task_operator_user_pipeline_emitToSinkMs{quantile=~\"0.5|0.95|0.99\"}",
          "refId": "A",
          "legendFormat": "age q={{quantile}} task={{subtask_index}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Policy decisions / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_pipeline_duplicateEvents[1m]))",
          "refId": "A",
          "legendFormat": "duplicateEvents"
        },
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_pipeline_latePriceEvents[1m]))",
          "refId": "B",
          "legendFormat": "latePriceEvents"
        },
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_pipeline_graceAcceptedEvents[1m]))",
          "refId": "C",
          "legendFormat": "graceAcceptedEvents"
        },
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_pipeline_invalidEvents[1m]))",
          "refId": "D",
          "legendFormat": "invalidEvents"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "EMA windows and output / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_pipeline_completedWindows[1m]))",
          "refId": "A",
          "legendFormat": "completedWindows"
        },
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_pipeline_emittedEvents[1m]))",
          "refId": "B",
          "legendFormat": "emittedEvents"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Indicator operator time: p95/p99",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flink_taskmanager_job_task_operator_pipeline_operatorMicros{quantile=~\"0.95|0.99\"}",
          "refId": "A",
          "legendFormat": "q={{quantile}} task={{subtask_index}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "\u00b5s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Busy and backpressured milliseconds / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flink_taskmanager_job_task_busyTimeMsPerSecond",
          "refId": "A",
          "legendFormat": "busy task={{subtask_index}}"
        },
        {
          "expr": "flink_taskmanager_job_task_backPressuredTimeMsPerSecond",
          "refId": "B",
          "legendFormat": "backpressure task={{subtask_index}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Checkpoint duration",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flink_jobmanager_job_lastCheckpointDuration",
          "refId": "A",
          "legendFormat": "duration"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Checkpoint failures and restarts",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flink_jobmanager_job_numberOfFailedCheckpoints",
          "refId": "A",
          "legendFormat": "failed checkpoints"
        },
        {
          "expr": "flink_jobmanager_job_numRestarts",
          "refId": "B",
          "legendFormat": "restarts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "Checkpoint size",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flink_jobmanager_job_lastCheckpointSize",
          "refId": "A",
          "legendFormat": "checkpoint bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "TaskManager JVM heap used and committed",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flink_taskmanager_Status_JVM_Memory_Heap_Used",
          "refId": "A",
          "legendFormat": "heap used {{tm_id}}"
        },
        {
          "expr": "flink_taskmanager_Status_JVM_Memory_Heap_Committed",
          "refId": "B",
          "legendFormat": "heap committed {{tm_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "title": "TaskManager JVM CPU load",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flink_taskmanager_Status_JVM_CPU_Load",
          "refId": "A",
          "legendFormat": "CPU {{tm_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 14,
      "title": "TaskManager garbage collection time",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate({__name__=~\"flink_taskmanager_Status_JVM_GarbageCollector_.*_Time\"}[1m])",
          "refId": "A",
          "legendFormat": "GC {{GarbageCollector}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 15,
      "title": "Watermark per indicator task",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "flink_taskmanager_job_task_operator_pipeline_watermark",
          "refId": "A",
          "legendFormat": "{{subtask_index}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 16,
      "title": "Metrics endpoints",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "up{job=~\"flink-.*|kafka\"}",
          "refId": "A",
          "legendFormat": "{{job}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 100,
      "title": "Structured pipeline logs",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service=~\"jobmanager|taskmanager\"} | json",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 110,
      "title": "Dummy emitter generated / acknowledged per second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(dummy_emitter_generated_total[1m])",
          "refId": "A",
          "legendFormat": "generated {{instance}}"
        },
        {
          "expr": "rate(dummy_emitter_acknowledged_total[1m])",
          "refId": "B",
          "legendFormat": "acknowledged {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 111,
      "title": "Dummy emitter delivery acknowledgement p99",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(dummy_emitter_delivery_ms_bucket[1m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 112,
      "title": "Dummy emitter pending and producer queues",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "{__name__=~\"dummy_emitter_pending_delayed|dummy_emitter_producer_queue\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 113,
      "title": "Dummy emitter failures",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "{__name__=~\"dummy_emitter_delivery_errors_total|dummy_emitter_undrained_total|dummy_emitter_unflushed_total\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ],
  "annotations": {
    "list": []
  }
}
