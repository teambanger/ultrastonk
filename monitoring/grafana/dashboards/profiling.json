      "title": "Emitter stage wall / call",
      "gridPos": {
        "x": 0,
        "y": 68,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by(component) (rate(dummy_emitter_profile_wall_seconds_total[1m])) / (sum by(component) (rate(dummy_emitter_profile_samples_total[1m])) > 0) * 1e6",
