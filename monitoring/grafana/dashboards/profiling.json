      "type": "timeseries",
      "title": "Collector health and sample age",
      "gridPos": {
        "x": 0,
        "y": 76,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pipeline_container_sample_success",
          "refId": "A",
          "legendFormat": "sample success {{container}}"
        },
        {
          "expr": "time() - pipeline_container_sample_timestamp_seconds",
          "refId": "B",
          "legendFormat": "sample age {{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
