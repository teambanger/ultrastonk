{
  "uid": "ultrastonk-profiling",
  "title": "Ultrastonk component profiles and resource efficiency",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "ultrastonk",
    "profiling"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read these profiles",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Stage wall/CPU time and allocation are sampled **per call**. EMA calls are per completed window; validation calls are per input. CPU share is an estimate among instrumented synchronous stages, not total JVM CPU. Resource ratios use container limits when set, otherwise shared host/VM capacity. Apply `compose.resources.yaml` for fixed budgets. Metrics use portable clocks and Docker accounting; hardware still affects performance."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Stage wall cost per call",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pipeline:component_wall_seconds_per_call{component=~\"$component\"} * 1e6",
          "refId": "A",
          "legendFormat": "{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "\u00b5s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Stage thread CPU cost per call",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "pipeline:component_cpu_seconds_per_call{component=~\"$component\"} * 1e6",
          "refId": "A",
          "legendFormat": "{{component}}"
        }
