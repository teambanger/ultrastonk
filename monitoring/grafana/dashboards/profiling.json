        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by(component) (rate(dummy_emitter_profile_cpu_seconds_total[1m])) / (sum by(component) (rate(dummy_emitter_profile_samples_total[1m])) > 0) * 1e6",
          "refId": "A",
          "legendFormat": "{{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "\u00b5s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
