KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_PARTITIONS=6
KAFKA_INPUT_TOPIC=price-events
KAFKA_OUTPUT_TOPIC=events-processed
KAFKA_REJECTED_TOPIC=price-events-rejected
KAFKA_GROUP_ID=ultrastonk-flink
KAFKA_TRANSACTION_PREFIX=ultrastonk-
FLINK_UI_PORT=8081
FLINK_PARALLELISM=2
WINDOW_SIZE_MS=300000
MAX_OUT_OF_ORDER_MS=5000
SOURCE_IDLE_TIMEOUT_MS=30000
CHECKPOINT_INTERVAL_MS=10000
DEDUP_STRATEGY=NONE
DEDUP_TTL_MS=3600000
LATE_EVENT_STRATEGY=DROP
ALLOWED_LATENESS_MS=30000
LOG_INTERVAL_MS=10000
FLINK_CHECKPOINTS_URI=file:///opt/flink/state/checkpoints
FLINK_SAVEPOINTS_URI=file:///opt/flink/state/savepoints
# For S3 checkpoint storage: flink-s3-fs-hadoop-1.20.3.jar
FLINK_FILESYSTEM_PLUGINS=
LOKI_WAL_DISK_FULL_THRESHOLD=0.9
PROFILE_ENABLED=true
# Profile the first invocation and then every Nth call; 1 profiles every call.
PROFILE_SAMPLE_EVERY=100
# Optional diagnostic mode: expose native task metrics per unchained operator.
PROFILE_ISOLATE_OPERATORS=false
RESOURCE_SAMPLE_INTERVAL_SECONDS=5
# Set to a retained checkpoint/savepoint directory to restore offsets AND EMA state.
FLINK_RESTORE_PATH=
